{
  "name": "QuickWeds Lifecycle Marketing Agent",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9,
              "triggerAtMinute": 15
            }
          ]
        }
      },
      "id": "05db595e-7061-405b-b6ad-59c4547927fc",
      "name": "Daily Lifecycle Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "url": "https://www.quickweds.site/api/agentops/lifecycle/eligible",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "25"
            },
            {
              "name": "agent",
              "value": "lifecycle_marketing_agent"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "bb00eb96-768c-4ccc-b9cb-b3cd083d95c5",
      "name": "Fetch Eligible Lifecycle Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        560,
        320
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "quickweds-agentops-auth",
          "name": "QuickWeds AgentOps Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const inputs = $input.all();\nconst rawTasks = [];\nfor (const item of inputs) {\n  const json = item.json ?? {};\n  if (Array.isArray(json)) rawTasks.push(...json);\n  else if (Array.isArray(json.tasks)) rawTasks.push(...json.tasks);\n  else if (Array.isArray(json.data)) rawTasks.push(...json.data);\n  else if (json.id || json.email || json.userId) rawTasks.push(json);\n}\n\nconst seen = new Set();\nconst allowedStages = new Set([\n  'welcome',\n  'onboarding_incomplete',\n  'wedding_site_unpublished',\n  'rsvp_not_configured',\n  'guest_list_idle',\n  'planner_pro_education',\n  'wedding_countdown',\n  'post_wedding_followup'\n]);\n\nconst tasks = rawTasks\n  .filter(task => task && typeof task === 'object')\n  .map(task => {\n    const riskLevel = task.riskLevel ?? (task.lifecycleStage === 'planner_pro_education' ? 'medium' : 'low');\n    const marketingLike = ['planner_pro_education', 'guest_list_idle', 'post_wedding_followup'].includes(task.lifecycleStage);\n    const blockedReason = !task.optedIn && marketingLike\n      ? 'marketing_requires_opt_in'\n      : task.suppressed\n        ? 'recipient_suppressed'\n        : !allowedStages.has(task.lifecycleStage)\n          ? 'unknown_lifecycle_stage'\n          : '';\n\n    return {\n      ...task,\n      agent: 'lifecycle_marketing_agent',\n      workflowIntent: 'quickweds_lifecycle_marketing',\n      riskLevel,\n      requiresApproval: Boolean(task.requiresApproval || riskLevel !== 'low' || marketingLike),\n      blocked: Boolean(blockedReason),\n      blockedReason,\n      auditAt: new Date().toISOString()\n    };\n  })\n  .filter(task => {\n    const key = task.id || `${task.userId ?? ''}:${task.email ?? ''}:${task.lifecycleStage ?? ''}`;\n    if (!key || seen.has(key)) return false;\n    seen.add(key);\n    return true;\n  })\n  .slice(0, 25);\n\nreturn tasks.map(task => ({ json: task }));"
      },
      "id": "7a9d69b2-2f30-4e97-82b3-aa598c6e1e67",
      "name": "Normalize and Guardrail Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.quickweds.site/api/agentops/summaries",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { agent: \"lifecycle_marketing_agent\", workflow: $workflow.name, executionId: $execution.id, ranAt: $now.toISO(), note: \"Daily lifecycle automation completed. Check approval queue and audit log for details.\" } }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "641b71a7-91c4-4f7a-a290-dca742225d15",
      "name": "Write Daily Agent Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1488,
        144
      ],
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "quickweds-agentops-auth",
          "name": "QuickWeds AgentOps Auth"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.requiresApproval }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            },
            {
              "leftValue": "={{ $json.blocked }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            }
          ],
          "combinator": "or"
        },
        "options": {
          "ignoreCase": false
        }
      },
      "id": "0ab25ff4-574e-4d47-84f9-7055c6fc723e",
      "name": "Needs Approval or Blocked?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1488,
        432
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.quickweds.site/api/agentops/approvals",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { task: $json, reason: $json.blocked ? $json.blockedReason : \"approval_required\" } }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "0aa67587-fe73-4a25-ad8b-ffd1a190ea81",
      "name": "Queue Approval or Suppression",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1808,
        256
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "quickweds-agentops-auth",
          "name": "QuickWeds AgentOps Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.quickweds.site/api/agentops/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { agent: \"lifecycle_marketing_agent\", action: \"queued_or_blocked\", taskId: $(\"Loop Lifecycle Tasks\").item.json.id, result: $json } }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "1ca7fe3f-39c6-4c90-8061-09125c75fbfd",
      "name": "Audit Approval Path",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2128,
        256
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "quickweds-agentops-auth",
          "name": "QuickWeds AgentOps Auth"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "bc636dae-9631-46bd-b8a1-17125dd7d161",
      "name": "Loop Lifecycle Tasks",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1184,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.quickweds.site/api/agentops/lifecycle/execute",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { task: $json, dryRun: false } }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "ef89e59c-658d-4487-b778-42ebfe5afcae",
      "name": "Execute Safe Lifecycle Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1808,
        560
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "quickweds-agentops-auth",
          "name": "QuickWeds AgentOps Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.quickweds.site/api/agentops/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { agent: \"lifecycle_marketing_agent\", action: \"executed_safe_task\", taskId: $(\"Loop Lifecycle Tasks\").item.json.id, result: $json } }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "0e1d55c4-a31a-40e8-8965-2a4535208887",
      "name": "Audit Execution Path",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2128,
        560
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "quickweds-agentops-auth",
          "name": "QuickWeds AgentOps Auth"
        }
      }
    }
  ],
