rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /quickweds/{userId}/{weddingId}/{allPaths=**} {
      // Anyone can read wedding media
      allow read: if true;
      
      // Deny all client-side writes. All uploads must go through our backend API
      // which uses the Firebase Admin SDK (bypassing these rules).
      allow write: if false;
    }
  }
}
