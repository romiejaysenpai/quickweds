# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PUBLIC_KEY=your_stripe_publishable_key
STRIPE_PLANNER_PRO_PRICE=899 # One-time Planner Pro price in Philippine Pesos (PHP)
STRIPE_ACCOUNT_PRO_PRICE=899 # One-time account-wide Pro price in Philippine Pesos (PHP)

# Resend Transactional Email
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=QuickWeds <noreply@yourdomain.com>
RESEND_COUPLE_TEMPLATE_ID=your_resend_couple_template_id

# Cloudinary
CLOUDINARY_URL=cloudinary://your_cloudinary_url

# Vercel (Custom Domains)
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TOKEN=your_vercel_api_token

# Application
NEXT_PUBLIC_APP_URL=https://www.quickweds.site
NEXT_PUBLIC_ROOT_DOMAIN=quickweds.site
CRON_SECRET=replace_with_a_long_random_secret_at_least_32_characters
AGENTOPS_API_KEY=replace_with_a_dedicated_agentops_secret_at_least_32_characters

# Required in production for distributed abuse protection. Do not reuse CRON_SECRET.
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_STATE_SECRET=replace_with_a_long_random_secret

# Admin Configuration
ADMIN_EMAIL=admin@example.com

