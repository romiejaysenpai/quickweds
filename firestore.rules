rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Weddings collection
    match /quickweds_weddings/{weddingId} {
      // Anyone can read a wedding (for the invitation page)
      allow read: if true;
      
      // Only authenticated users can create/update/delete their own weddings
      // Note: We use the backend API to enforce this more strictly, but rules add a layer of defense.
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // RSVPs collection
    match /quickweds_rsvps/{rsvpId} {
      // Only the wedding owner can read the RSVPs
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/quickweds_weddings/$(resource.data.wedding_id)).data.user_id == request.auth.uid;
      
      // Anyone can create an RSVP (public invitation)
      allow create: if true;
      
      // No one can update or delete RSVPs through the client
      allow update, delete: if false;
    }
  }
}
